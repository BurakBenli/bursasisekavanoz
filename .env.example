# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun. .env depoya girmez.

# Sitenin tam adresi (canonical, sitemap, e-posta bağlantıları)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Faz 2: veritabanı (bilgisayardaki PostgreSQL; Docker yok) ---
# DATABASE_URL=postgresql://KULLANICI@localhost:5432/bursa_dev
# DATABASE_URL_TEST=postgresql://KULLANICI@localhost:5432/bursa_test

# --- Faz 4: e-posta (geliştirmede Mailpit: localhost:1025, arayüz localhost:8025) ---
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# --- Faz 5: panel ---
# SESSION_SECRET=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=   # en az 12 karakter; yalnızca ilk kurulumda (npm run admin:create)
